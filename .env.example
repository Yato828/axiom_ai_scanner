# Optional. The scanner runs without it, but image generation requires it.
OPENAI_API_KEY=
# Optional fallback list. If set, this is used before OPENAI_API_KEY.
OPENAI_API_KEYS=
OPENAI_RESPONSES_MODEL=gpt-5.5
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

# Used by /hybrid.html and /api/hybrid-image.
WAVESPEED_API_KEY=
# Optional fallback list. If set, this is used before WAVESPEED_API_KEY.
WAVESPEED_API_KEYS=
WAVESPEED_IMAGE_SIZE=1024*1024
WAVESPEED_TIMEOUT_SECONDS=120
WAVESPEED_SYNC_MODE=false
WAVESPEED_POLL_INTERVAL_SECONDS=1.0

# Speeds up repeated dashboard refreshes by reusing recent scan results.
AXIOM_SCAN_CACHE_SECONDS=45

# Development uses bounded in-memory state and local background threads.
# Production requires Redis, a separate worker and the public HTTPS origin.
AXIOM_ENV=development
AXIOM_PUBLIC_ORIGIN=http://127.0.0.1:8080
REDIS_URL=
# Set to 1 only behind a trusted proxy that overwrites X-Forwarded-For.
AXIOM_TRUST_PROXY=0
AXIOM_QUEUE_CAPACITY=16
AXIOM_GENERATION_WORKERS=2
AXIOM_GENERATION_HOURLY_LIMIT=100

# Real Pump.fun launches. Server-side only; never put these in browser code.
# Use a dedicated HTTPS Solana MAINNET RPC endpoint with appropriate capacity.
AXIOM_LAUNCH_ENABLED=1
SOLANA_RPC_URL=
# Public IPFS uploads through Pinata. Files are public and kept on IPFS.
PINATA_JWT=
